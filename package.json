{
  "name": "royal-exceptions",
  "private": true,
  "version": "1.0.0",
  "description": "Royal Exceptions — a browser fantasy-romance visual novel (React + TypeScript + Vite, static Cloudflare Pages).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "verify:sources": "node scripts/verify-sources.mjs",
    "content": "tsx scripts/compile-content.ts",
    "content:check": "tsx scripts/compile-content.ts --check",
    "art": "node scripts/optimize-art.mjs",
    "art:check": "node scripts/optimize-art.mjs --check",
    "fonts": "node scripts/fetch-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "lint": "eslint .",
    "dev": "vite",
    "build": "npm run verify:sources && npm run content:check && npm run art:check && npm run typecheck && vite build",
    "build:esbuild": "node scripts/build-esbuild.mjs",
    "preview": "vite preview --port 4173",
    "shots": "node tests/browser/explore-shots.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.30.0",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.1.0"
  }
}
